{
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "target": "ESNext",
    "types": []
  },
  "include": [
    "./**/*.ts",
    "./deno-env.d.ts"
  ]
}
