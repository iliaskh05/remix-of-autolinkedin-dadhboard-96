# ---------------------------------------------------------------------------
# Server-only secrets — set via `supabase secrets set`, NEVER as VITE_* vars:
#   LOVABLE_API_KEY=...     # Lovable gateway (used when BYOK is OFF)
#   GEMINI_API_KEY=...      # optional workspace Gemini key (BYOK direct fallback)
#   FIRECRAWL_API_KEY=...
#   CRON_SECRET=...
# User BYOK keys (gemini_api_key, openai_api_key) live in user_settings, not here.
# ---------------------------------------------------------------------------
